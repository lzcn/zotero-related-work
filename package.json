{
  "name": "zotero-related-work",
  "version": "0.2.0",
  "private": true,
  "description": "Find similar papers in your Zotero library.",
  "license": "AGPL-3.0-or-later",
  "author": "Zhi Lu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzcn/zotero-related-work.git"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "npm run lint:check",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "node tests/unit.test.js && node --test tests/integration.test.js tests/lifecycle.test.js tests/search.test.js tests/semantic.test.js tests/package.test.mjs tests/tags.test.js",
    "check": "npm run lint:check && node scripts/build.mjs --check && npm test",
    "release": "npm run check && node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit",
    "build:force": "node scripts/build.mjs --force",
    "test:host": "node scripts/test-host.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@huggingface/transformers": "3.8.1",
    "esbuild": "0.25.10",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "zotero-types": "3.1.9"
  },
  "config": {
    "addonName": "Related Work",
    "addonID": "similar-works@lzcn",
    "addonRef": "similar-works",
    "prefsPrefix": "extensions.zotero.similar-works"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf"
  },
  "overrides": {
    "epubjs": {
      ".": "0.3.93",
      "@xmldom/xmldom": "0.9.12"
    },
    "sharp": "^0.35.4"
  }
}
